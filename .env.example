# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-14
SANITY_API_READ_TOKEN=your-read-token
# Editor token — required for scripts that mutate content (import-to-sanity, create-notion-post, etc.)
SANITY_WRITE_TOKEN=your-write-token

# Site
SITE_URL=https://nicharalambous.com
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# AWS (used in GitHub Actions, not locally)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nicharalambous.com
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
