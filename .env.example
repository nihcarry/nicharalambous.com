# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-14
SANITY_API_READ_TOKEN=your-read-token
# Editor token — required for scripts that mutate content (import-to-sanity, create-notion-post, etc.)
SANITY_WRITE_TOKEN=your-write-token

# Site
SITE_URL=https://nicharalambous.com
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# GitHub PAT for testing the Sanity → deploy webhook (scripts/test-github-dispatch.ts).
# Classic token: public_repo scope. Fine-grained: Contents read+write on this repo.
# GITHUB_PAT=ghp_your_token_here

# YouTube → blog automation (used by scripts/import-youtube-video.ts +
# scripts/generate-tldrs.ts, and by the scheduled GitHub Action).
YOUTUBE_CHANNEL_ID=UC-your-channel-id

# Transcript fetching. Set SUPADATA_API_KEY for cloud/CI runs (YouTube blocks
# datacenter IPs). Free tier: 100/month, no card — https://supadata.ai
# Leave unset for local runs; the script falls back to the direct library.
# SUPADATA_API_KEY=your-supadata-key

# TL;DR generation. Set ANTHROPIC_API_KEY to auto-write TL;DRs with Claude
# (https://console.anthropic.com). Without any LLM key, `npm run tldr` queues
# transcripts to /tmp for an in-editor pass (npm run tldr:apply).
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional alternative provider:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# AWS (used in GitHub Actions, not locally)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nicharalambous.com
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
